<UserControl x:Class="BedrockLauncher.Pages.Settings.Versions.Component_VersionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:classes="clr-namespace:BedrockLauncher.Classes"
             xmlns:viewModels="clr-namespace:BedrockLauncher.ViewModels"
             xmlns:conv="clr-namespace:JemExtensions.WPF.Converters;assembly=JemExtensions"
             d:DataContext="{d:DesignInstance Type=classes:MCVersion}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InvertBoolean"/>
        <conv:BooleanAndConverter x:Key="BooleanAndConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid x:Name="InstallationEntry" Margin="0,8,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="380"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconPath}" Grid.Column="0" HorizontalAlignment="Left" Width="40" Height="40" Margin="0,0,0,0">
                <Image.OpacityMask>
                    <ImageBrush ImageSource="{Binding IconPath}"/>
                </Image.OpacityMask>
            </Image>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock FontSize="16" Foreground="{DynamicResource PrimaryText.Foreground}" FontWeight="DemiBold" Padding="0,0,0,0" Text="{Binding DisplayName}"/>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource SecondaryText.Foreground}"
                           FontWeight="SemiBold"
                           Text="{Binding LibraryStatusText}"
                           ToolTip="{Binding LibraryStatusReason}"/>
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource TertiaryText.Foreground}"
                           Text="{Binding LibrarySourceText}"/>
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource TertiaryText.Foreground}"
                           Text="{Binding InstallationSize}"/>
                <TextBlock FontSize="9"
                           Foreground="{DynamicResource TertiaryText.Foreground}"
                           Text="{Binding UUID}"/>
            </StackPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Column="2" x:Name="ButtonPanel" Visibility="Collapsed">
            <Button x:Name="AddToPlay"
                    Click="AddToPlay_Click"
                    Content="Add to Play"
                    MinWidth="88"
                    Margin="0,0,5,0"
                    ToolTip="Create or select a Play installation for this exact version"
                    Visibility="{Binding CanAddToPlay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource DialogButton_Green}">
                <Button.IsEnabled>
                    <Binding Source="{x:Static viewModels:MainDataModel.Default}" Path="ProgressBarState.AllowEditing" Mode="OneWay"/>
                </Button.IsEnabled>
            </Button>
            <Button x:Name="InstallVersionButton"
                    Click="InstallVersion_Click"
                    Content="Install"
                    MinWidth="64"
                    Margin="0,0,5,0"
                    ToolTip="Install this exact version for the current Play profile without launching"
                    Visibility="{Binding CanAddToPlay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource DialogButton_Orange}">
                <Button.IsEnabled>
                    <Binding Source="{x:Static viewModels:MainDataModel.Default}" Path="ProgressBarState.AllowEditing" Mode="OneWay"/>
                </Button.IsEnabled>
            </Button>
            <Button x:Name="Cache"
                    Click="Cache_Click"
                    Content="Cache"
                    ToolTip="{Binding LibraryStatusReason}"
                    Visibility="{Binding CanCacheVersion, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{DynamicResource DialogButton_Green}">
                <Button.IsEnabled>
                    <Binding Source="{x:Static viewModels:MainDataModel.Default}" Path="ProgressBarState.AllowEditing" Mode="OneWay"/>
                </Button.IsEnabled>
            </Button>
            <Button x:Name="Repair" Click="Repair_Click" Content="{DynamicResource GeneralText_Repair}" Style="{DynamicResource DialogButton_Orange}" Visibility="{Binding IsCached, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                        <Binding Source="{x:Static viewModels:MainDataModel.Default}" Path="ProgressBarState.AllowEditing" Mode="OneWay"/>
                        <Binding Path="IsCustom" Converter="{StaticResource InvertBoolean}" Mode="OneWay"  />
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
            <Button x:Name="Folder" Click="Folder_Click" Visibility="{Binding IsCached, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" FontWeight="Bold" Style="{DynamicResource DialogButton}">
                <Button.Content>
                    <Grid Width="16" Height="16">
                        <Path Stretch="Uniform" Fill="{DynamicResource OveralElements.Background}" StrokeThickness="0" Data="{DynamicResource FolderIcon}"/>
                    </Grid>
                </Button.Content>
            </Button>
            <Button x:Name="More" Visibility="{Binding IsCached, Converter={StaticResource BooleanToVisibilityConverter}}" FontWeight="Bold" Style="{DynamicResource DialogButton}" Click="More_Click">
                <Button.Content>
                    <Image Width="16" Height="16" Source="{DynamicResource Expandable}" Stretch="None"/>
                </Button.Content>
                <Button.ContextMenu>
                    <ContextMenu Closed="ContextMenu_Closed" Style="{DynamicResource NoCheckboxContextMenu}">
                        <MenuItem Header="{DynamicResource GeneralText_Remove}" IsEnabled="{Binding Source={x:Static viewModels:MainDataModel.Default}, Path=ProgressBarState.AllowEditing, Mode=OneWay}" Name="Remove" Click="Delete_Click"></MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
